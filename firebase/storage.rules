rules_version = '2';

// Public read for published glossary images; uploads restricted to admins (see users/{uid} in Firestore).
service firebase.storage {
  match /b/{bucket}/o {
    // Single Firestore read (duplicate firestore.get() in one rule can mis-evaluate in some clients).
    function adminUserDoc() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        (
          adminUserDoc().data.role == 'admin' ||
          adminUserDoc().data.isAdmin == true
        );
    }

    match /glossary/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
